{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fynix GM",
  "version": "0.1.0",
  "identifier": "com.boc.fynix-gm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Fynix GM",
        "width": 1024,
        "height": 720,
        "resizable": true,
        "fullscreen": false,
        "decorations": false
      }
    ],
    "security": {
      "csp": "default-src blob: data: wss: ws: 'self' 'unsafe-eval' 'unsafe-inline'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src blob: data: 'self' https:; font-src 'self' https:; connect-src 'self' https: ws: wss:"
    }
  },
  "bundle": {
    "active": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "targets": ["deb", "rpm", "AppImage"],
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-37",
          "libgtk-3-0"
        ]
      },
      "appimage": {}
    }
  }
}
